# Font Config
font-family = "JetBrains Mono"
font-size = 14

# Theme
theme = TokyoNight

# Mouse & Cursor
mouse-hide-while-typing = true

# Padding
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-padding-color = background

# Background
background-blur = 255
background-opacity = 0.92

# Title
title = "Ghostty"

# Keybinds
keybind = global:cmd+backquote=toggle_quick_terminal

