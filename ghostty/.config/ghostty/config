# Font Config
font-family = "VictorMono Nerd Font Propo"
# font-family = "CaskaydiaCove Nerd Font Propo"
font-size = 14
font-thicken = true
font-thicken-strength = 255

# Theme
theme = TokyoNight

# Mouse & Cursor
mouse-hide-while-typing = true

# Padding
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-padding-color = background

# Background
background-blur = 255
background-opacity = 0.92

# Title
title = "Ghostty"

# Keybinds
keybind = global:cmd+backquote=toggle_quick_terminal

# shaders
custom-shader = shaders/cursor-smear.glsl
# custom-shader = shaders/cursor-smear-fade.glsl
custom-shader = shaders/better_crt.glsl
custom-shader = shaders/bloom_50.glsl
